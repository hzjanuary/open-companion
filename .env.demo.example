# Copy to .env.demo and restrict access: chmod 600 .env.demo
JANUARY_ENVIRONMENT=local
JANUARY_LOG_LEVEL=INFO
JANUARY_DATABASE_HOST=127.0.0.1
JANUARY_DATABASE_PORT=5432
JANUARY_REDIS_URL=redis://127.0.0.1:6379/0
JANUARY_TELEGRAM_ENABLED=true
JANUARY_TELEGRAM_BOT_TOKEN=REPLACE_WITH_DEDICATED_TEST_BOT_TOKEN
JANUARY_TELEGRAM_DELIVERY_MODE=polling
JANUARY_TELEGRAM_PLATFORM_CONNECTION_ID=
JANUARY_DEMO_ALLOWED_CHAT_IDS='["REPLACE_WITH_TEST_CHAT_ID"]'
JANUARY_DEMO_LIVE_ENABLED=false
JANUARY_DEMO_LIVE_TELEGRAM_VERIFICATION_ENABLED=false
JANUARY_LLM_ENABLED=true
JANUARY_LLM_PRIMARY_PROVIDER=ollama
JANUARY_LLM_OLLAMA_MODEL=REPLACE_WITH_MODEL
JANUARY_LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434
JANUARY_LLM_LIVE_VERIFICATION_ENABLED=false
JANUARY_OUTBOUND_DELIVERY_ENABLED=true
JANUARY_OUTBOUND_OWNER_NAME=demo-outbound
JANUARY_COMMAND_WORKER_ENABLED=true
JANUARY_COMMAND_OWNER_NAME=demo-commands
JANUARY_DATA_GOVERNANCE_ENABLED=true
JANUARY_GOVERNANCE_WORKER_ENABLED=true
JANUARY_GOVERNANCE_OWNER_NAME=demo-governance
JANUARY_RETENTION_WORKER_ENABLED=true
JANUARY_CONVERSATION_CONSUMER_NAME=demo-conversation
JANUARY_PLANNING_OWNER_NAME=demo-planning
JANUARY_TELEGRAM_STICKER_MAPPING={}
