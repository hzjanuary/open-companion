JANUARY_INGRESS_OUTBOX_POLL_INTERVAL_SECONDS=1
JANUARY_INGRESS_EVENT_SCHEMA_VERSION=1
JANUARY_CONVERSATION_CONSUMER_NAME=
JANUARY_CONVERSATION_WORKER_POLL_INTERVAL_SECONDS=1
