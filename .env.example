JANUARY_PERSONAL_CONTEXT_LIMIT=5
JANUARY_PERSONAL_CONTEXT_CHARACTER_BUDGET=600
JANUARY_MEMORY_CONTROL_BATCH_SIZE=100
# Optional derived index for user-created explicit memories only. Keep disabled
