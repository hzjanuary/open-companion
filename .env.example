JANUARY_RATE_LIMIT_DELIVERY_CONVERSATION_PER_SECOND=2
JANUARY_RATE_LIMIT_REDIS_FAILURE_RETRY_SECONDS=5
JANUARY_RATE_LIMIT_COOLDOWN_NOTICE_SECONDS=60
# Independent in-flight provider capacity; JSON values are local deployment policy.
JANUARY_PROVIDER_CONCURRENCY_ENABLED=false
JANUARY_PROVIDER_CONCURRENCY_LIMITS={}
JANUARY_PROVIDER_CONCURRENCY_LEASE_SECONDS=60
