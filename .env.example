# Complete runtime-setting inventory for local development. Do not put real
# secrets here and do not use this file as production configuration.
# REQUIRED FIRST RUN (Docker self-host): use .env.self-host.example and
# docs/runbooks/self-hosted-quickstart.md instead of editing all 244 settings.
# TELEGRAM: token + chosen polling/webhook + authenticated canonical scope.
# LLM PROVIDER: only chosen model/key, or keyless reachable local Ollama.
# DATABASE / REDIS: required guarded runtime; self-host Compose keeps them private.
# OPTIONAL QDRANT: semantic/knowledge feature + worker + embedding/profile pair.
# OPTIONAL TTS: explicit OpenAI governed /voice; no TTS key for ordinary text.
# OPTIONAL WEBHOOK: HTTPS/public base URL + secret only when webhook is chosen.
# OPTIONAL ADVANCED / OPERATIONS: metrics/exports/tuning and downstream hardening.
# This native-development file keeps existing typed defaults/inventory unchanged.
# Self-host controls are enforced by its distinct topology, not these defaults.
JANUARY_APP_NAME=January
JANUARY_ENVIRONMENT=local
JANUARY_LOG_LEVEL=INFO
JANUARY_METRICS_ENABLED=false
JANUARY_METRICS_EXPORT_ENABLED=false
JANUARY_METRICS_BIND_HOST=127.0.0.1
JANUARY_METRICS_PORT=9464
JANUARY_PLANNING_METRICS_PORT=9465
JANUARY_SUMMARY_METRICS_PORT=9466
JANUARY_SEMANTIC_MEMORY_METRICS_PORT=9467
JANUARY_PROVIDER_GOVERNANCE_METRICS_PORT=9468
# JSON mapping: {"provider:model":{"input_microusd_per_million":0,"output_microusd_per_million":0}}
JANUARY_METRICS_PROVIDER_PRICING={}
# SPEC-026 rollout is operator-controlled. `legacy` preserves prior routing;
# `observe` accounts without hard denial; `enforce` applies pre-I/O budgets.
JANUARY_PROVIDER_GOVERNANCE_MODE=legacy
JANUARY_PROVIDER_GOVERNANCE_WORKER_ENABLED=false
JANUARY_PROVIDER_GOVERNANCE_OWNER_NAME=provider-governance
JANUARY_PROVIDER_GOVERNANCE_BATCH_SIZE=50
JANUARY_PROVIDER_GOVERNANCE_POLL_INTERVAL_SECONDS=5
JANUARY_PROVIDER_RESERVATION_LEASE_SECONDS=60
JANUARY_DATABASE_HOST=127.0.0.1
JANUARY_DATABASE_PORT=5432
JANUARY_DATABASE_NAME=january
JANUARY_DATABASE_USER=january
JANUARY_DATABASE_PASSWORD=january-local
# Optional complete URL alternative; when set it must use postgresql+asyncpg.
JANUARY_DATABASE_URL=
JANUARY_DATABASE_POOL_SIZE=5
JANUARY_DATABASE_MAX_OVERFLOW=5
JANUARY_DATABASE_CONNECT_TIMEOUT_SECONDS=3
JANUARY_DATABASE_ECHO=false
JANUARY_TELEGRAM_ENABLED=false
# SPEC-028 requires enforce-mode provider policies and enabled concurrency.
JANUARY_TELEGRAM_MEDIA_ENABLED=false
JANUARY_TELEGRAM_MEDIA_PHOTO_MAX_BYTES=5242880
JANUARY_TELEGRAM_MEDIA_AUDIO_MAX_BYTES=5242880
JANUARY_TELEGRAM_MEDIA_PHOTO_MAX_SIDE=1280
JANUARY_TELEGRAM_MEDIA_AUDIO_MAX_DURATION_SECONDS=120
JANUARY_TELEGRAM_MEDIA_TRANSCRIPT_MAX_CHARACTERS=4000
JANUARY_TELEGRAM_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=15
JANUARY_TELEGRAM_MEDIA_TRANSCRIPTION_TIMEOUT_SECONDS=20
# SPEC-038 reply-only voice playback. Enabling requires enforced OpenAI TTS
# governance, rate/concurrency coordination, and command/outbound workers.
JANUARY_TELEGRAM_VOICE_TTS_ENABLED=false
JANUARY_TELEGRAM_VOICE_TTS_MODEL=gpt-4o-mini-tts
JANUARY_TELEGRAM_VOICE_TTS_VOICE=alloy
JANUARY_TELEGRAM_VOICE_TTS_SOURCE_MAX_CHARACTERS=4000
JANUARY_TELEGRAM_VOICE_TTS_OUTPUT_MAX_BYTES=5242880
JANUARY_TELEGRAM_VOICE_TTS_TIMEOUT_SECONDS=30
JANUARY_TELEGRAM_VOICE_ARTIFACT_GRACE_HOURS=24
JANUARY_TELEGRAM_VOICE_ARTIFACT_HARD_RETENTION_DAYS=7
JANUARY_TELEGRAM_BOT_TOKEN=
JANUARY_TELEGRAM_API_BASE_URL=https://api.telegram.org
JANUARY_TELEGRAM_TIMEOUT_SECONDS=10
JANUARY_TELEGRAM_CONNECT_TIMEOUT_SECONDS=5
JANUARY_TELEGRAM_CONNECTION_LIMIT=10
JANUARY_TELEGRAM_USER_AGENT=january/0.1
JANUARY_TELEGRAM_DELIVERY_MODE=disabled
JANUARY_TELEGRAM_PLATFORM_CONNECTION_ID=
JANUARY_TELEGRAM_TENANT_ID=
JANUARY_TELEGRAM_ALLOWED_UPDATES='["message","edited_message","my_chat_member","chat_member"]'
JANUARY_TELEGRAM_WEBHOOK_SECRET_TOKEN=
JANUARY_TELEGRAM_WEBHOOK_PUBLIC_BASE_URL=
JANUARY_TELEGRAM_WEBHOOK_BODY_LIMIT_BYTES=1048576
JANUARY_TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40
JANUARY_TELEGRAM_POLL_TIMEOUT_SECONDS=30
JANUARY_TELEGRAM_POLL_BATCH_LIMIT=100
JANUARY_TELEGRAM_POLL_RETRY_BACKOFF_SECONDS=1
JANUARY_TELEGRAM_POLL_MAX_BACKOFF_SECONDS=30
JANUARY_REDIS_URL=redis://127.0.0.1:6379/0
JANUARY_REDIS_STREAM_NAME=january:incoming-updates
JANUARY_REDIS_CONSUMER_GROUP=january-ingress
JANUARY_REDIS_BLOCK_TIMEOUT_MS=1000
JANUARY_REDIS_BATCH_SIZE=10
JANUARY_REDIS_RECLAIM_IDLE_MS=60000
JANUARY_RATE_LIMIT_ENABLED=true
JANUARY_RATE_LIMIT_GENERATION_DEPLOYMENT_PER_MINUTE=60
JANUARY_RATE_LIMIT_GENERATION_CONNECTION_PER_MINUTE=30
