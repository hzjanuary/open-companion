# Minimal guarded text-chat configuration for compose.self-host.yaml.
# This is not a runnable bot until local secrets, credentials and policies exist.
# Copy to ignored .env.self-host with restricted permissions; never source it.
# Compose env_file uses raw values: no shell commands, expansion or outer quotes.
# Docker Engine + Compose supporting env_file format: raw are required.
# Full typed inventory remains in .env.example; omitted settings retain defaults.

# Local operator secrets/configuration, not paid accounts. No defaults for secrets.
JANUARY_APP_NAME=January
JANUARY_DATABASE_NAME=january
JANUARY_DATABASE_USER=january
JANUARY_DATABASE_PASSWORD=
JANUARY_CONTROL_PLANE_JWT_SECRET=
JANUARY_CONTROL_PLANE_JWT_ISSUER=january-self-host
JANUARY_CONTROL_PLANE_JWT_AUDIENCE=january-control
JANUARY_CONTROL_PLANE_DEPLOYMENT_BOOTSTRAP_SUBJECTS=["self-host-operator"]

# Required Telegram credential. Setup must verify identity and record real IDs.
JANUARY_TELEGRAM_ENABLED=true
JANUARY_TELEGRAM_BOT_TOKEN=
JANUARY_TELEGRAM_DELIVERY_MODE=polling
JANUARY_TELEGRAM_TENANT_ID=
JANUARY_TELEGRAM_PLATFORM_CONNECTION_ID=
JANUARY_COMMAND_WORKER_ENABLED=true
JANUARY_OUTBOUND_DELIVERY_ENABLED=true

# Choose one supported provider/model. Only that hosted provider needs its key.
# Ollama needs no key but does need an accessible model server; loopback is container-local.
JANUARY_LLM_ENABLED=true
JANUARY_LLM_PRIMARY_PROVIDER=openai
JANUARY_LLM_OPENAI_MODEL=
JANUARY_LLM_OPENAI_API_KEY=
JANUARY_LLM_GEMINI_MODEL=
JANUARY_LLM_GEMINI_API_KEY=
JANUARY_LLM_GROQ_MODEL=
JANUARY_LLM_GROQ_API_KEY=
JANUARY_LLM_OPENROUTER_MODEL=
JANUARY_LLM_OPENROUTER_API_KEY=
JANUARY_LLM_OLLAMA_MODEL=
JANUARY_LLM_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Conditional webhook only: leave both blank for polling; no DNS/TLS needed.
JANUARY_TELEGRAM_WEBHOOK_PUBLIC_BASE_URL=
JANUARY_TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Optional capabilities off: no Qdrant, embedding or TTS dependency for text chat.
JANUARY_TELEGRAM_MEDIA_ENABLED=false
JANUARY_TELEGRAM_VOICE_TTS_ENABLED=false
JANUARY_CONVERSATION_SUMMARIES_ENABLED=false
JANUARY_SUMMARY_WORKER_ENABLED=false
JANUARY_SEMANTIC_MEMORY_ENABLED=false
JANUARY_SEMANTIC_MEMORY_WORKER_ENABLED=false
JANUARY_KNOWLEDGE_RAG_ENABLED=false
JANUARY_KNOWLEDGE_INDEX_WORKER_ENABLED=false
JANUARY_PROACTIVE_SCHEDULING_ENABLED=false
JANUARY_SCHEDULER_WORKER_ENABLED=false
JANUARY_EMBEDDING_PROVIDER=
JANUARY_EMBEDDING_MODEL=

# Engineering controls are mandatory in this topology, including internal auth.
JANUARY_RATE_LIMIT_ENABLED=true
JANUARY_PROVIDER_CONCURRENCY_ENABLED=true
JANUARY_SAFETY_MODERATION_ENABLED=true
JANUARY_PROVIDER_GOVERNANCE_MODE=enforce
JANUARY_PROVIDER_GOVERNANCE_WORKER_ENABLED=true
JANUARY_CONTROL_PLANE_ENABLED=true
JANUARY_DATA_GOVERNANCE_ENABLED=true
JANUARY_GOVERNANCE_WORKER_ENABLED=true
JANUARY_RETENTION_WORKER_ENABLED=true

# Optional local telemetry; no monitoring vendor or external service is required.
JANUARY_METRICS_ENABLED=true
JANUARY_METRICS_EXPORT_ENABLED=false

# Compose-only host API override (container port remains 8000).
JANUARY_HOST_PORT=8000
